# Server environment template. Copy to `.env` (never commit `.env`).

# Database. Local dev defaults to SQLite (no Docker needed); CI/prod use Postgres 16.
#   dev  : sqlite:///./msai.db
#   prod : postgresql+psycopg://msai:<password>@localhost:5432/msai
DATABASE_URL=sqlite:///./msai.db

# Comma-separated allowed CORS origins (web dev server, etc.).
CORS_ORIGINS=http://localhost:5173

# Where checkpoint weights are stored (large files, never committed).
MODEL_STORAGE_DIR=./storage/models

# Optional API bearer token. If unset, auth is disabled (local dev).
# API_TOKEN=change-me

# Postgres (used by docker-compose.yml). Keep secrets out of source control.
POSTGRES_DB=msai
POSTGRES_USER=msai
POSTGRES_PASSWORD=change-me
